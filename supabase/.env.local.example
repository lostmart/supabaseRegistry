# Local Supabase Configuration — EXAMPLE TEMPLATE
# Copy this file to supabase/.env.local and fill in your real credentials.
# ⚠️ NEVER commit supabase/.env.local — it is in .gitignore

# Google OAuth Configuration
# Get these from https://console.cloud.google.com → APIs & Services → Credentials
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=your_google_client_id_here
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=your_google_client_secret_here

# OpenAI API Key (optional — used by Supabase Studio AI features)
# OPENAI_API_KEY=your_openai_api_key_here
